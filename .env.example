# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Douyin Lead Mining System
DEBUG=false

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=douyin_leads
DATABASE_URL=postgresql://postgres:change-me@db:5432/douyin_leads

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Security / JWT ──────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── External APIs ───────────────────────────────────────────────────────────
SENTIMENT_API_KEY=
SENTIMENT_API_URL=https://api.tikhub.io
SENTIMENT_ADAPTER=api
SENTIMENT_API_TIMEOUT=30
SENTIMENT_MAX_PAGES=5
SENTIMENT_TOPIC_VIDEO_LIMIT=5

# LLM - 通义千问
LLM_API_KEY=sk-your-dashscope-api-key
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen3.8-max
LLM_ADAPTER=http

# ─── Dustess OpenKF ─────────────────────────────────────────────────────────
OPENKF_APPID=
OPENKF_KEY_ID=
OPENKF_KEY=
OPENKF_CALLBACK_URL=
OPENKF_LOCAL_APP_ID=

# ─── Chat Control / Risk ─────────────────────────────────────────────────────
DAILY_SEND_LIMIT=50
MIN_SEND_INTERVAL=2
MAX_SEND_INTERVAL=5
WORK_HOURS_START=9
WORK_HOURS_END=22
MAX_ACCOUNTS_PER_USER=10

# ─── Douyin Automation (Playwright) ──────────────────────────────────────────
DOUYIN_AUTOMATION_MODE=mock
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_QR_LOGIN_TTL_SEC=120
PLAYWRIGHT_CONTEXT_IDLE_MIN=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost","http://localhost:80","https://lxy887.icu","http://lxy887.icu"]
